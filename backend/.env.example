# Copien este archivo a backend/.env y pongan valores reales. backend/.env NO se sube al repositorio.
# Clave para proteger la API del backend (mínimo 16 caracteres). Generen una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=cambien-esta-clave-por-una-larga-y-aleatoria

SYMBOL=BTCUSDT
INTERVAL=1d
MEXC_BASE_URL=https://api.mexc.com
# Ollama local (sin autenticación propia: el backend actúa como gateway protegido)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120
DB_PATH=data/agent.db
MODEL_DIR=models
RISK_CONFIG=config/risk.json
# Cada cuántos segundos se revisa si hay una vela diaria nueva cerrada
CYCLE_SECONDS=300
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# No se requiere ninguna clave de MEXC: solo se usan datos públicos. Las órdenes reales no existen en este proyecto.
